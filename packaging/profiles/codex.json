{
  "harness": "codex",
  "name": "Codex",
  "contents": "the skills",
  "install": ["codex plugin marketplace add Trevoke/{repo}", "codex plugin add {plugin}@the-recs-files"],
  "agents": "role file",
  "capabilities": {
    "delegate": {
      "status": "native",
      "brief": "spawn_agent ({role})",
      "sentence": "spawn_agent ({role})",
      "brief-role-file": "spawn_agent (default, with the text of `{roleFile}` first in its prompt)",
      "sentence-role-file": "spawn_agent with the text of `{roleFile}` first in its prompt",
      "roles": { "recs-code-reviewer": "role file" },
      "roleNames": { "general-purpose": "default" }
    },
    "handoff": { "status": "prose" },
    "clear": { "status": "native" },
    "load": { "status": "native", "skill": "{skill}" },
    "tool": { "status": "native" },
    "ask": { "status": "prose" },
    "memory": { "status": "native", "list": "the `update_plan` plan", "in-progress": "in_progress", "completed": "completed" },
    "restrict": { "status": "prose" }
  },
  "files": {
    "plugin.json": {
      "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
      "name": "{plugin}", "version": "{version}", "description": "{description}"
    },
    ".agents/plugins/marketplace.json": {
      "name": "the-recs-files",
      "plugins": [{
        "name": "{plugin}",
        "source": { "source": "local", "path": "./" },
        "policy": { "installation": "AVAILABLE", "authentication": "ON_INSTALL" },
        "category": "Coding"
      }]
    }
  }
}
